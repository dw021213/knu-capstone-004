DATABASE_URL=postgres://jeju:jeju@localhost:5433/jeju?sslmode=disable
SERVER_ADDR=:8080
# 프론트 주소(쉼표로 여러 개). 비우면 개발용으로 모든 origin 허용
CORS_ORIGINS=
# 기상청 API허브 인증키 (https://apihub.kma.go.kr 마이페이지). 실제 키는 .env 에만 넣는다
KMA_APIHUB_KEY=

# 지도 좌표별 현재 날씨용 공공데이터포털 단기예보 조회서비스 키 (/api/weather/live). 실제 키는 .env 에만
KMA_SERVICE_KEY=
