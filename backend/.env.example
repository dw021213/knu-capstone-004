DATABASE_URL=postgres://jeju:jeju@localhost:5433/jeju?sslmode=disable
SERVER_ADDR=:8080
# 프론트 주소(쉼표로 여러 개). 비우면 개발용으로 모든 origin 허용
CORS_ORIGINS=

# 산책 코스. 카카오맵 API 사용 설정을 켜고 JavaScript SDK 도메인을 등록한다.
KAKAO_MAP_JS_KEY=
# 서버에서 도보 경로를 조회할 때 사용하는 REST 키
KAKAO_MAP_REST_KEY=

# 서버 환경 또는 프로젝트 루트 .env.local 에 설정 (브라우저에 전달하지 않음)
SKT_APP_KEY=
SKT_POI_IDS=2769058
SKT_DAILY_LIMIT=10
