# cp .env.example .env 후 값을 채운다. .env 는 git 에 올리지 않는다.
# 백엔드 주소 (무료 서브도메인 예: jeju-risk.duckdns.org). 서버 IP 를 가리키게 해 두어야 HTTPS 인증서가 발급된다
DOMAIN=
# DB 비밀번호 (아무 긴 문자열, 예: openssl rand -hex 24)
POSTGRES_PASSWORD=
# 프론트 주소(쉼표로 여러 개). 비우면 모두 허용
CORS_ORIGINS=
# 기상청 API허브 인증키 (실시간 기상 수집). 비우면 수집 꺼짐
KMA_APIHUB_KEY=
