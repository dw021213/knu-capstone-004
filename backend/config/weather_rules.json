{
  "version": "weather_rules_v2",
  "description": "기상청 특보 발표 기준을 참고한 관측값 기준. 2일 연속 등 지속 조건은 쓰지 않고 해당 시각 관측으로 판별한다. 공식 특보가 아님.",
  "max_bonus": 0.3,
  "rules": [
    {
      "key": "heavy_rain",
      "label": "호우",
      "weights": {
        "advisory": 0.0,
        "warning": 0.15
      },
      "criteria": [
        {
          "metric": "rain_3h",
          "op": ">=",
          "advisory": 60,
          "warning": 90
        },
        {
          "metric": "rain_12h",
          "op": ">=",
          "advisory": 110,
          "warning": 180
        }
      ],
      "evidence": {
        "advisory": "RR 0.63 (0.39~1.01) → −0.08, 0 처리",
        "warning": "RR 2.37 (1.47~3.82) → +0.146 (+0.06~+0.23), 유의"
      }
    },
    {
      "key": "strong_wind",
      "label": "강풍",
      "weights": {
        "advisory": 0.0,
        "warning": 0.1
      },
      "criteria": [
        {
          "metric": "wind",
          "op": ">=",
          "advisory": 14,
          "warning": 21,
          "mountain": {
            "advisory": 17,
            "warning": 24
          }
        }
      ],
      "evidence": {
        "advisory": "RR 0.33 (0.16~0.65) → −0.19, 유의하게 사고 감소(이동 감소 추정), 0 처리",
        "warning": "2021 해당 셀-일 없음 → v1 값 유지"
      }
    },
    {
      "key": "heavy_snow",
      "label": "대설",
      "weights": {
        "advisory": 0.1,
        "warning": 0.2
      },
      "criteria": [
        {
          "metric": "snow_24h",
          "op": ">=",
          "advisory": 5,
          "warning": 20,
          "mountain": {
            "advisory": 20,
            "warning": 30
          }
        }
      ],
      "evidence": {
        "advisory": "적설 관측 없음 → v1 값 유지",
        "warning": "적설 관측 없음 → v1 값 유지"
      }
    },
    {
      "key": "heat",
      "label": "폭염",
      "weights": {
        "advisory": 0.0,
        "warning": 0.07
      },
      "criteria": [
        {
          "metric": "feels_like",
          "op": ">=",
          "advisory": 33,
          "warning": 35
        }
      ],
      "evidence": {
        "advisory": "RR 0.91 (0.65~1.27) → −0.02, 0 처리",
        "warning": "RR 1.50 (0.37~6.04) → +0.07, 유의하지 않음"
      }
    },
    {
      "key": "cold",
      "label": "한파",
      "weights": {
        "advisory": 0.11,
        "warning": 0.11
      },
      "criteria": [
        {
          "metric": "temp",
          "op": "<=",
          "advisory": -12,
          "warning": -15
        }
      ],
      "evidence": {
        "advisory": "RR 1.95 (0.63~6.06) → +0.11, 유의하지 않음",
        "warning": "2021 사고 0건 → 추정 불가, 주의보급 값으로 맞춤"
      }
    },
    {
      "key": "dry",
      "label": "건조",
      "weights": {
        "advisory": 0.03,
        "warning": 0.03
      },
      "criteria": [
        {
          "metric": "humidity_24h",
          "op": "<=",
          "advisory": 35,
          "warning": 25
        }
      ],
      "evidence": {
        "advisory": "RR 1.22 (0.92~1.63) → +0.03, 유의하지 않음",
        "warning": "RR 0.53 (0.26~1.06) → −0.11, 주의보급 값으로 맞춤"
      }
    }
  ],
  "calibration": "2026-10-14 영향도 비례: 2021 교통사고 구급출동(셀-일, 월 고정효과 Poisson)에서 기준 초과일의 사고율 배수 RR 을 점수로 환산(Δ = ln RR / 5.916, 기본점수 +0.1 → 사고율 ×1.81). 음수는 0, 경보급 ≥ 주의보급, 추정 불가는 v1 값 유지. 재현: analysis/calibration.py. 유의(95% CI 가 0 제외)한 것은 호우 경보급(+)·강풍 주의보급(−)뿐"
}
